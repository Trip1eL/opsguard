# Copy to .env only when creating a new local environment.
CHAT_MODEL_PROVIDER=relay
GPT_MODEL_NAME=gpt-5.5
OPSGUARD_LLM_ENABLED=false
RELAY_API_KEY=
RELAY_BASE_URL=
HTTP_PROXY_URL=

# Optional LangSmith observability for real model calls.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=opsguard-dev

# Compose development defaults. Keep real credentials out of Git.
POSTGRES_DB=opsguard
POSTGRES_USER=opsguard
POSTGRES_PASSWORD=change-me
REDIS_URL=redis://redis:6379/0
OPENSEARCH_URL=http://opensearch:9200
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# Optional real adapters. Defaults keep the local fixture demo dependency-free.
OPSGUARD_EVENT_BACKEND=jsonl
OPSGUARD_GRAPH_BACKEND=memory
OPSGUARD_RULE_SANDBOX=offline
OPSGUARD_OPENSEARCH_SEED_FIXTURES=false
OPSGUARD_SANDBOX_IMAGE=opsguard:latest
